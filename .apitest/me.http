### 用户登录
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{testUser.email}}",
  "password": "{{testUser.password}}"
}

> {%
    client.test("Login successful", function() {
        client.assert(response.status === 200, "Expected status 200");
        client.assert(response.body.access_token, "Access token should be present");
        client.assert(response.body.refresh_token, "Refresh token should be present");
    });

    client.global.set("accessToken", response.body.access_token);
    client.global.set("refreshToken", response.body.refresh_token);
%}

### 获取当前用户信息
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{accessToken}}


### 全量替换当前用户资料（PUT）
PUT {{baseUrl}}/api/v1/me
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "username": "renamed_user",
  "email": "renamed@example.com"
}


### 局部更新（RFC 7386 JSON Merge Patch）
PATCH {{baseUrl}}/api/v1/me
Content-Type: application/merge-patch+json
Authorization: Bearer {{accessToken}}

{
  "email": "merged@example.com"
}


### 修改当前用户密码
POST {{baseUrl}}/api/v1/me/change-password
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "old_password": "{{testUser.password}}",
  "new_password": "{{newPassword}}"
}
